  "_control_totals_policy": "Accounting policy of the demo company: EBITDA = income 60/61/64 − costs 50–54 − card fees 568 (operating); EBIT = EBITDA − depreciation 551; profit before tax = all income and costs except tax 59; net profit = classes 5 and 6.",
  "board": {
    "ebitda_vs_revenue": {
      "min_revenue_yoy": 0.0,
      "max_ebitda_yoy": -0.1
    },
    "month_concentration": {
      "min_multiple_of_average": 3.0
    },
    "category_decline": {
      "consecutive_quarters": 3
    }
  },
  "_board_pack": "Board pack: figures in sql/papiernictvo2/40_boardpack.sql; rest-of-year forecast = plan × pace of the last N months; risks and opportunities = rules with the thresholds below (€ impact on EBITDA); controller comments in comments.xlsx (an input, the engine does not write it; every run produces a template in the output).",
  "board_pack": {
    "runrate_months": 3,
    "tax_rate": 0.21,
    "tax_row": "Income tax",
    "tax_cost_center": "C00",
    "pbt_row": "Profit before tax",
    "ebitda_row": "EBITDA",
    "headline_rows": [
      "Revenue",
      "EBITDA",
      "Net profit"
    ],
    "variance_top": 8,
    "variance_min_eur": 1000.0,
    "ro_min_eur": 500.0,
    "ro": {
      "revenue_pace": {
        "min_gap": 0.05
      },
      "cost_spike_repeat": {
        "min_yoy": 0.2,
        "exclude": [
          "Cost of goods sold"
        ]
      },
      "category_trend": {
        "consecutive_quarters": 3
      }
    },
    "comments_file": "comments.xlsx",
    "variance_rows": [
      "Gross margin",
      "Staff",
      "Rent",
      "Energy",
      "Marketing",
      "Services",
      "Other"
    ]
  },
  "not_verified": [
    "whether a posting is on the right account in substance — the checks verify the reconciliation of sources and totals; the cost centre and month of invoices are matched to the invoice register",
    "VAT — the rates on receipts are not checked against the category; what is checked is revenue excl. VAT (604) and the total incl. VAT by day and payment method",
    "depreciation (551) — not checked without a fixed asset register; income tax (591) is an interim estimate of 21% of profit, not checked against the tax return (only the payment of the advance 341 from the bank is checked — except for the last month of the period, whose payment arrives after the period)",
    "authenticity of source documents — a fake receipt entered in the POS and in TOTAL, or a fictitious invoice from a supplier in the master data that is posted and paid, will pass: source ↔ source reconciliation by design cannot see a source falsified at the start",
    "goods category on the receipt — the POS is the only source; a shift of revenue between categories with the same VAT rate is not detected",
    "shortage and stock write-off — a stock issue without a sale recorded consistently in stock, journal and trial balance will pass",
    "tolerance of €0.05 a day in the reconciliation of revenue excl. VAT (VAT rounding on receipts) — at most ~€100 for the whole period",
    "bank account balance against the real bank — the statement is checked against itself and against the books",
    "payments of opening liabilities as at 2024-12-31 are matched only to balance sheet account 321 (the invoice register starts in 2025)",
    "plan values — shape only (a plan is an intention, not a fact)",
    "exceptions are switched off until management decides — every finding means DOES NOT TIE"
  ],
  "exceptions": "exceptions.json",
  "contract": "contract.json",
  "_pivot": "Pivot: exports/<company>/pivot.xlsx from the mart_facts mart (sql/papiernictvo2/50_pivot.sql) — only when the verdict is TIES; verified by xlsx_readback + pivot_pl_match (facts by account == P&L by line, to the cent).",
  "pivot": true,
