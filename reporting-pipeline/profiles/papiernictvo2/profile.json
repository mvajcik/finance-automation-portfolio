{
  "_meta": {
    "purpose": "Profile of the fictional demo company (robust inputs, full P&L) for the profile-driven engine, model retail_full. Loading and checks are in the engine, data transformations in sql/papiernictvo2/*.sql; the P&L subtotals (EBITDA, EBIT …) are defined by this profile (pl_subtotals).",
    "company": "Papiernictvo DEMO s.r.o. (fictional)"
  },
  "company": "Papiernictvo DEMO s.r.o.",
  "model": "retail_full",
  "sql_dir": "sql/papiernictvo2",
  "checks": [
    "inputs_contract",
    "stg_parse_contract",
    "numeric_contract",
    "full_duplicate_keys",
    "full_coverage",
    "pos_control_total",
    "journal_tb_match",
    "pos_gl_match",
    "bank_balance",
    "bank_gl_match",
    "bank_ap_match",
    "payroll_gl_match",
    "ap_gl_match",
    "stock_consistency",
    "posting_policy",
    "liability_settlement",
    "card_settlement",
    "loan_schedule",
    "account_mapping_complete",
    "pl_control_total",
    "boardpack_consistency"
  ],
  "period": {
    "start": "2025-01",
    "months": 21,
    "as_of": "2026-09",
    "_source": "last year 2025 in full, current year 2026 to September; full-year forecast = Oct–Dec 2026"
  },
  "entity_label": "cost centres",
  "inputs": {
    "pos": {
      "pattern": "pos_{cc}_{ym}.csv",
      "per": "month",
      "cost_centers": [
        "S01",
        "S02",
        "S03",
        "S04"
      ],
      "sep": ";",
      "encoding": "utf-8",
      "header": [
        "receipt",
        "datetime",
        "till",
        "category",
        "quantity",
        "unit_price_incl_vat",
        "vat_rate",
        "total_incl_vat",
        "payment"
      ],
      "skip_until_header": true,
      "footer_prefix": "TOTAL"
    },
    "journal": {
      "pattern": "journal_{ym}.csv",
      "per": "month",
      "sep": ",",
      "encoding": "utf-8-sig",
      "header": [
        "Document",
        "Date",
        "Dr",
        "Cr",
        "Amount",
        "Cost centre",
        "Description"
      ]
    },
    "gl": {
      "pattern": "trial_balance_{ym}.xlsx",
      "per": "month",
      "sheet": "Trial balance",
      "header": [
        "Period",
        "Cost centre",
        "Account",
        "Account name",
        "Debit turnover",
        "Credit turnover"
      ]
    },
    "invoices": {
      "pattern": "invoices_{ym}.xlsx",
      "per": "month",
      "sheet": "Received invoices",
      "header": [
        "Number",
        "Supplier",
        "Company ID",
        "Issue date",
        "Due date",
        "Account",
        "Cost centre",
        "Text",
        "Net",
        "VAT",
        "Total"
      ]
    },
    "payroll": {
      "pattern": "payroll_{ym}.csv",
      "per": "month",
      "sep": ";",
      "encoding": "cp1250",
      "header": [
        "employee_no",
        "cost_centre",
        "position",
        "gross_pay",
        "employer_contributions",
        "employee_contributions",
        "tax",
        "net_pay"
      ]
    },
    "bank": {
      "pattern": "bank_{ym}.csv",
      "per": "month",
      "sep": ";",
      "encoding": "utf-8",
      "skip_until_header": true,
      "header": [
        "Date",
        "Counterparty",
        "Counterparty IBAN",
        "Reference",
        "Amount",
        "Currency",
        "Description"
      ],
      "meta": {
        "opening": "Opening balance",
        "closing": "Closing balance"
      }
    },
    "stock_moves": {
      "pattern": "stock_moves_{ym}.csv",
      "per": "month",
      "sep": ";",
      "encoding": "utf-8",
      "header": [
        "document",
        "date",
        "type",
        "store",
        "category",
        "cost_value"
      ]
    },
    "stock_state": {
      "pattern": "stock_levels_{ym}.csv",
      "per": "month",
      "sep": ";",
      "encoding": "utf-8",
      "header": [
        "store",
        "category",
        "opening",
        "received",
        "issued",
        "closing"
      ]
    },
    "plan": {
      "pattern": "plan_{y2}.xlsx",
      "per": "once",
      "sheet": "Plan 2026",
      "header_first": [
        "Account",
        "Cost centre"
      ]
    },
    "dims": {
      "pattern": "master_data.xlsx",
      "per": "once",
      "sheets": [
        "Accounts",
        "Cost centres",
        "Categories",
        "Suppliers"
      ]
    }
  },
  "shops": [
    {
      "name": "Store Centrum",
      "cost_center": "S01"
    },
    {
      "name": "Store Sídlisko",
      "cost_center": "S02"
    },
    {
      "name": "Store OC",
